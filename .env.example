# Copy to .env and fill in. Never commit .env.
# With no .env at all, everything runs on mocks and SQLite.

# Which component kinds use mocks. "all", "none", or a comma list of:
# vad, stt, langid, llm, tts, agent, trace_sink
MULTIVOCO_MOCK=all

MULTIVOCO_DATABASE_URL=sqlite+aiosqlite:///./multivoco.db
# Shown next to every latency figure. Set to the Space's region when deployed.
MULTIVOCO_REGION=local

# Per-language provider overrides as JSON, merged over the defaults in app/core/languages.py.
# MULTIVOCO_ROUTE_OVERRIDES={"kn": {"llm": "gemini"}}

# Session limits
MULTIVOCO_MAX_CALL_SECONDS=300
MULTIVOCO_MAX_TURNS=40
MULTIVOCO_IDLE_TIMEOUT_SECONDS=30
MULTIVOCO_MAX_CONCURRENT_SESSIONS=2

# Provider keys
MULTIVOCO_DEEPGRAM_API_KEY=
MULTIVOCO_GROQ_API_KEY=
MULTIVOCO_GEMINI_API_KEY=
MULTIVOCO_AZURE_SPEECH_KEY=
MULTIVOCO_AZURE_SPEECH_REGION=
